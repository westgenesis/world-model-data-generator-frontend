# @label 开发环境
# 部署配置：由 pnpm docker:build 选择后通过 --env-file 传给 docker compose
# 本机覆盖或敏感配置请写入同目录的 dev.local.env（不入库）

# Compose 项目名（不同环境需不同，才能在同一台机器并存）
COMPOSE_PROJECT_NAME=wmdg-dev

# 镜像名与标签
IMAGE_NAME=world-model-data-generator-frontend
IMAGE_TAG=dev

# 宿主机对外端口
WEB_PORT=8080

# 后端服务地址，/api/* 请求将原样转发到此地址
API_UPSTREAM=http://host.docker.internal:8080
