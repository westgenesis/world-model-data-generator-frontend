# 由官方镜像在启动时通过 envsubst 渲染：
#   ${API_UPSTREAM}         后端服务地址
#   ${NGINX_LOCAL_RESOLVERS} 容器内 DNS（NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 自动生成）

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 100m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 健康检查
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 接口反向代理；使用变量 + resolver，后端暂不可用时 nginx 仍能启动
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 支持 WebSocket / SSE（任务进度推送等）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # 带 hash 的构建产物长期缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        # location 内的 add_header 会覆盖 server 级配置，需重复声明安全头
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # SPA 路由回退；index.html 不缓存以便及时发布新版本
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
